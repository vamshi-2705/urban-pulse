# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Data directories (ignore large data files but track catalogs and .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.json
!data/processed/*/*.json
!data/processed/*/*/*.json
data/outputs/*
!data/outputs/.gitkeep
!data/outputs/*.json
!data/outputs/*/*.json

# Geospatial binary & large file formats
*.tif
*.tiff
*.jp2
*.nc
*.hdf
*.tar.gz
*.zip
*.parquet

# Logs
logs/
*.log

# Environment variables & secrets
.env
.env.local
*.pem
credentials.json
