# ==============================================================================
# UrbanPulse - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides.
# In hosted environments (Render, Railway), configure these via Dashboard Environment Variables.

# Server Port
# Note: Render and Railway set PORT automatically at runtime.
PORT=5001

# Environment Mode ('production' or 'development')
NODE_ENV=production

# Data Source Provider
# Options:
#   real     - Real Sentinel-2 geospatial outputs in data/outputs/api/ (recommended for demo).
#   mock     - In-memory dataset. Zero external dependencies.
#   file     - Reads directly from filesystem JSON in data/mock/.
#   postgres - Persists to PostgreSQL. Requires DATABASE_URL.
DATA_PROVIDER=real

# Custom Intelligence Data File Path (Optional, for DATA_PROVIDER=file)
# If omitted, defaults to data/mock/investigation_list.json
# DATA_FILE_PATH=/app/data/mock/investigation_list.json

# PostgreSQL Database Connection URL (Required only if DATA_PROVIDER=postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# DATABASE_URL=postgresql://postgres:password@localhost:5432/urbanpulse?sslmode=require
